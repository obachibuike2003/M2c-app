# Local development: copy to .env. On a server, put real values in its own
# .env (never commit real values).
SECRET_KEY=change-me-before-any-real-deployment
DATABASE_URL=sqlite:///easy2buy.db
FLASK_DEBUG=1

# Sites allowed to call this API (comma-separated). Left empty, it defaults to
# the live static site, https://m2c-app-vqeb.onrender.com.
CORS_ORIGINS=

# Password for the admin account (admin@demo.com), used when the database is
# first created. Left empty, a random one is generated and printed to the log.
ADMIN_PASSWORD=

# https://platform.openai.com/api-keys - needed for AiStudio's "Generate" button.
OPENAI_API_KEY=
