# Local development: copy to .env. On Render, set these in the service's
# Environment tab instead (never commit real values).
SECRET_KEY=change-me-before-any-real-deployment
DATABASE_URL=sqlite:///easy2buy.db
FLASK_DEBUG=1

# Sites allowed to call this API (comma-separated). Left empty, it defaults to
# the live static site, https://m2c-app-vqeb.onrender.com.
CORS_ORIGINS=

# 1 on Render (HTTPS, frontend on another domain). Set 0 when testing over
# plain http://localhost, or the browser will refuse the login cookie.
CROSS_SITE_COOKIES=0

# https://platform.openai.com/api-keys - needed for AiStudio's "Generate" button.
OPENAI_API_KEY=
