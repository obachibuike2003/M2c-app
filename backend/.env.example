# Local development: copy to .env. On a server, put real values in its own
# .env (never commit real values).
SECRET_KEY=change-me-before-any-real-deployment
DATABASE_URL=sqlite:///easy2buy.db
FLASK_DEBUG=1

# Sites allowed to call this API (comma-separated). Left empty, it defaults to
# the live static site, https://m2c-app-vqeb.onrender.com.
CORS_ORIGINS=

# Password for the admin account (admin@demo.com), used when the database is
# first created. Left empty, a random one is generated and printed to the log.
ADMIN_PASSWORD=

# https://platform.openai.com/api-keys - powers AiStudio's "Generate" button and
# makes search-by-photo recognise what's in the picture (it still works without).
OPENAI_API_KEY=
# Image model for "Generate". gpt-image-1-mini is the cheapest; others are tried
# automatically if your account can't use the one set here.
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Nomba online payments (https://dashboard.nomba.com > Developer > API Keys).
# Until these are set, checkouts only offer pay on delivery.
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
# The signature key you choose in Developer > Webhook Setup. Webhook URL:
#   https://api.eazy2buychina.com/api/payments/nomba/webhook  (event: payment_success)
NOMBA_WEBHOOK_KEY=
# sandbox while testing; live once Nomba enables your production keys.
NOMBA_ENV=sandbox

# Email (order emails, tracking updates, team alerts, forgot password).
# Gmail: turn on 2-step verification, then Google Account > Security > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=eazy2buychina@gmail.com
SMTP_PASSWORD=
MAIL_FROM=Eazy2buy <eazy2buychina@gmail.com>
# Where new-order alerts go (defaults to SMTP_USER)
ADMIN_EMAIL=
